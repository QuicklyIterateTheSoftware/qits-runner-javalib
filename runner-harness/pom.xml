<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-runner</artifactId>
        <version>2026.1023.211240</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The harness runner and its suite (feature "Proof"): a minimal RunnerDomain wired against
         qits-runner-toolkit and exercised over a fake host, inside this repository's own build —
         proving the toolkit before qits-workspaces-runner-daemon (qits-624) does it live. NOT
         PUBLISHED: this is a test fixture, not a product. maven.deploy.skip and
         maven.install.skip keep it out of the local repository and off the release's artifact
         list; .config/qits/release.yml never names it, and the
         release CLI publishes only what it declares either way. -->
    <artifactId>qits-runner-harness</artifactId>
    <name>qits-runner :: runner-harness</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-runner-toolkit</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- FILTERING IS ON FOR ONE RESOURCE AND NOTHING ELSE: the harness's version, which
             HarnessIdentity reads through RunnerBinaryVersion as a real runner's protocol jar does
             (its version is its image tag). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>eu/wohlben/qits/runner/harness/harness-binary.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>eu/wohlben/qits/runner/harness/harness-binary.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
